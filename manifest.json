{
  "manifest_version": 3,
  "name": "ETHGlobalists",
  "short_name": "ETHGlobalists",
  "version": "1.0.0",
  "description": "See only the winners on the ETHGlobal showcase. Works with its event, partner, category and search filters.",
  "homepage_url": "https://github.com/adilhusain01/ETHGlobalists",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ETHGlobalists",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://ethglobal.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
